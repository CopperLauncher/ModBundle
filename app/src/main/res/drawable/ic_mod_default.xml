<?xml version="1.0" encoding="utf-8"?>
<!-- Generic "missing icon" glyph ported from Copper-Android's ic_mod_placeholder: a clean
     isometric box outline, distinct from any real mod artwork, so it reads clearly as "no
     icon available" rather than as a logo or a stuck loading state. Also used as the
     default instance icon (see InstanceAdapter) when no logo has been chosen. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.4"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:pathData="M12,3 L20,7.5 L20,16.5 L12,21 L4,16.5 L4,7.5 Z" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.2"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:pathData="M4,7.5 L12,12 L20,7.5 M12,12 L12,21" />
</vector>

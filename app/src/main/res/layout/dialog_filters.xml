<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Source"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp"
        android:layout_marginBottom="4dp"/>
    <Spinner
        android:id="@+id/filter_spinner_source"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_spinner"
        android:popupBackground="?attr/colorSurfaceContainer"
        android:spinnerMode="dropdown"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Content Type"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp"/>
    <Spinner
        android:id="@+id/filter_spinner_content_type"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_spinner"
        android:popupBackground="?attr/colorSurfaceContainer"
        android:spinnerMode="dropdown"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Minecraft Version"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp"/>
    <Spinner
        android:id="@+id/filter_spinner_version"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_spinner"
        android:popupBackground="?attr/colorSurfaceContainer"
        android:spinnerMode="dropdown"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Loader"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp"/>
    <Spinner
        android:id="@+id/filter_spinner_loader"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_spinner"
        android:popupBackground="?attr/colorSurfaceContainer"
        android:spinnerMode="dropdown"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="18dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Include Snapshots"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"/>
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/filter_switch_snapshots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

</LinearLayout>
</ScrollView>

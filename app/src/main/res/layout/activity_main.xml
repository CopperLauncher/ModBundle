<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/colorSurfaceContainer"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:elevation="4dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_modbundle_logo"
            android:background="@null"
            android:adjustViewBounds="true"
            android:scaleType="centerInside"
            android:contentDescription="ModBundle logo"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ModBundle"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"/>

    </LinearLayout>

    <!-- Content area fills remaining space -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- BROWSE TAB -->
        <LinearLayout
            android:id="@+id/layout_browse"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Source Toggle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="4dp"
                android:background="?attr/colorSurfaceContainer">
                <Button
                    android:id="@+id/btn_modrinth"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Modrinth"
                    android:textSize="13sp"
                    android:backgroundTint="?attr/colorPrimary"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginEnd="4dp"
                    style="@style/Widget.MaterialComponents.Button"/>
                <Button
                    android:id="@+id/btn_curseforge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="CurseForge"
                    android:textSize="13sp"
                    android:backgroundTint="?attr/colorSurfaceContainer"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginStart="4dp"
                    style="@style/Widget.MaterialComponents.Button"/>
            </LinearLayout>
            <!-- Content Type Toggle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingBottom="4dp"
                android:background="?attr/colorSurfaceContainer">
                <Button
                    android:id="@+id/btn_type_mods"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mods"
                    android:textSize="11sp"
                    android:backgroundTint="?attr/colorPrimary"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginEnd="3dp"
                    style="@style/Widget.MaterialComponents.Button"/>
                <Button
                    android:id="@+id/btn_type_resourcepack"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Res Packs"
                    android:textSize="11sp"
                    android:backgroundTint="?attr/colorSurfaceContainer"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginEnd="3dp"
                    style="@style/Widget.MaterialComponents.Button"/>
                <Button
                    android:id="@+id/btn_type_shader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Shaders"
                    android:textSize="11sp"
                    android:backgroundTint="?attr/colorSurfaceContainer"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    style="@style/Widget.MaterialComponents.Button"/>
            </LinearLayout>
            <!-- Search Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:background="?attr/colorSurfaceContainer">

                <EditText
                    android:id="@+id/search_input"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:hint="Search mods…"
                    android:textColorHint="?attr/colorOnSurfaceVariant"
                    android:textColor="?attr/colorOnSurface"
                    android:background="@drawable/bg_search"
                    android:paddingHorizontal="14dp"
                    android:singleLine="true"
                    android:imeOptions="actionSearch"
                    android:inputType="text"/>
            </LinearLayout>

            <!-- Filters Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingBottom="8dp"
                android:background="?attr/colorSurfaceContainer">

                <CheckBox
                    android:id="@+id/btn_snapshots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Include Snapshots"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11sp"
                    android:buttonTint="?attr/colorPrimary"
                    android:checked="false"
                    android:layout_marginEnd="4dp"/>
                <Spinner
                    android:id="@+id/spinner_version"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_spinner"
                    android:popupBackground="?attr/colorSurfaceContainer"
                    android:spinnerMode="dropdown"/>

                <Spinner
                    android:id="@+id/spinner_loader"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_spinner"
                    android:popupBackground="?attr/colorSurfaceContainer"
                    android:spinnerMode="dropdown"/>
            </LinearLayout>

            <!-- Progress -->
            <ProgressBar
                android:id="@+id/browse_progress"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:indeterminate="true"
                android:indeterminateTint="?attr/colorPrimary"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:visibility="gone"/>

            <!-- Mod List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/browse_recycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="8dp"/>

            <!-- Empty state -->
            <TextView
                android:id="@+id/empty_browse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No mods found"
                android:textColor="#666"
                android:textSize="15sp"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone"/>

        </LinearLayout>

        <!-- INSTALLED TAB -->
        <LinearLayout
            android:id="@+id/layout_installed"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:background="?attr/colorSurfaceContainer">
                <TextView
                    android:id="@+id/installed_tab_mods"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Mods"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"/>
                <TextView
                    android:id="@+id/installed_tab_shaders"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Shaders"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp"
                    android:gravity="center"/>
                <TextView
                    android:id="@+id/installed_tab_resourcepacks"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Res Packs"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp"
                    android:gravity="center"/>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="?attr/colorPrimary"/>
            <!-- Toolbar row 1: file count + check updates -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="4dp">
                <TextView
                    android:id="@+id/tv_installed_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 files"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp"/>
                <Button
                    android:id="@+id/btn_check_updates"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="Check Updates"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="11sp"
                    android:backgroundTint="?attr/colorSurfaceContainer"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/installed_recycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="16dp"/>

            <TextView
                android:id="@+id/empty_installed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No mods installed yet"
                android:textColor="#666"
                android:textSize="15sp"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone"/>

        </LinearLayout>

        <!-- SETTINGS TAB -->
        <LinearLayout
            android:id="@+id/layout_settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:orientation="vertical">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textColor="?attr/colorOnSurface"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp"/>


            <!-- Auto Search Path Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Active Instance"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                android:layout_marginBottom="6dp"/>
            <TextView
                android:id="@+id/tv_folder_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No instance selected"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp"
                android:background="@drawable/bg_search"
                android:padding="12dp"
                android:layout_marginBottom="6dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select an instance from the Instances tab."
                android:textColor="?attr/colorOutline"
                android:textSize="11sp"
                android:layout_marginBottom="12dp"/>
            <Button
                android:id="@+id/btn_choose_folder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pick Instance Manually"
                android:textColor="?attr/colorOnSurface"
                android:backgroundTint="?attr/colorPrimary"
                android:visibility="gone"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333"
                android:layout_marginVertical="24dp"/>

            <!-- About Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="About"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                android:layout_marginBottom="12dp"/>

            <!-- YouTube -->
            <LinearLayout
                android:id="@+id/tv_link_youtube"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_about_bubble"
                android:padding="14dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:tag="https://www.youtube.com/@MaxJubayerYT">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_youtube"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YouTube"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>

            <!-- GitHub ModBundle -->
            <LinearLayout
                android:id="@+id/tv_github_link"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_about_bubble"
                android:padding="14dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:tag="https://github.com/CopperLauncher/ModBundle">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_github"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GitHub — ModBundle"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>

            <!-- Ko-fi -->
            <LinearLayout
                android:id="@+id/tv_link_kofi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_about_bubble"
                android:padding="14dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:tag="https://ko-fi.com/maxjubayeryt">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_kofi"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ko-fi"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>

            <!-- Patreon -->
            <LinearLayout
                android:id="@+id/tv_link_patreon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_about_bubble"
                android:padding="14dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:tag="https://patreon.com/MaxJubayerYT">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_patreon"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Patreon"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>

            <!-- Discord -->
            <LinearLayout
                android:id="@+id/tv_discord_link"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_about_bubble"
                android:padding="14dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:tag="https://discord.gg/j8GTQv3YvY">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_discord"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Discord"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>

            <!-- GitHub CopperLauncher -->
            <LinearLayout
                android:id="@+id/tv_link_copper_github"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_about_bubble"
                android:padding="14dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:tag="https://github.com/CopperLauncher/Copper-Android">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_github"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GitHub — Copper Launcher"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>

            <!-- Modrinth -->
            <LinearLayout
                android:id="@+id/tv_link_modrinth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_about_bubble"
                android:padding="14dp"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                android:tag="https://modrinth.com/user/MaxJubayerYT">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_modrinth_si"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Modrinth — MaxJubayerYT"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>
            </LinearLayout>
            </ScrollView>

        </LinearLayout>

    
        <include
            android:id="@+id/layout_instances"
            layout="@layout/layout_instances"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"/>
    </FrameLayout>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainer"
        app:itemTextColor="?attr/colorOnSurfaceVariant"
        app:itemIconTint="@drawable/bottom_nav_tint"
        app:menu="@menu/bottom_nav_menu"/>

</LinearLayout>

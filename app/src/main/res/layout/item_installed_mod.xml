<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_mod_card"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="10dp"
    android:padding="16dp"
    android:minHeight="80dp"
    android:gravity="center_vertical">

    <!-- Checkbox for bulk select -->
    <CheckBox
        android:id="@+id/mod_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="?attr/colorPrimary"
        android:layout_marginEnd="8dp"
        android:visibility="gone"/>

    <!-- Mod Icon -->
    <ImageView
        android:id="@+id/mod_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_icon_placeholder"
        android:layout_marginEnd="14dp"/>

    <!-- Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/mod_filename"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"
            android:maxLines="1"
            android:ellipsize="middle"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">
            <TextView
                android:id="@+id/mod_type_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=".jar"
                android:textColor="@color/md_success"
                android:textSize="12sp"
                android:background="@drawable/bg_mod_card"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:layout_marginEnd="10dp"/>
            <TextView
                android:id="@+id/mod_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#888"
                android:textSize="13sp"/>

        </LinearLayout>
    </LinearLayout>

    <!-- Switch version button -->
    <ImageButton
        android:id="@+id/btn_switch_version"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="10dp"
        android:src="@drawable/ic_swap_horiz"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:tint="?attr/colorPrimary"
        android:contentDescription="Switch version"
        android:layout_marginEnd="4dp"/>

    <!-- Update button -->
    <ImageButton
        android:id="@+id/btn_update_mod"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="10dp"
        android:src="@drawable/ic_update"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:tint="?attr/colorPrimary"
        android:contentDescription="Update mod"
        android:visibility="gone"
        android:layout_marginEnd="4dp"/>

    <!-- Disable button -->
    <ImageButton
        android:id="@+id/btn_disable_mod"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="10dp"
        android:src="@drawable/ic_pause"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:tint="?attr/colorOnSurfaceVariant"
        android:contentDescription="Disable mod"
        android:layout_marginEnd="4dp"/>

    <!-- Delete button -->
    <ImageButton
        android:id="@+id/btn_delete_mod"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="10dp"
        android:src="@drawable/ic_delete"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:tint="?attr/colorError"
        android:contentDescription="Delete mod"/>
</LinearLayout>

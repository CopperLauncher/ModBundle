<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@color/md_background</item>
        <item name="android:statusBarColor">@color/md_surface</item>
        <item name="android:navigationBarColor">@color/md_surface</item>

        <!-- Full M3 color-role mapping. Both values/colors.xml (light) and
             values-night/colors.xml (dark) define the same md_* names, so this single
             theme automatically switches between them with the system's night mode —
             and gets overridden entirely by Material You dynamic color on Android 12+. -->
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>

        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>

        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>

        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>

        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorOnBackground">@color/md_on_background</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorSurfaceContainer">@color/md_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_container_high</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>

        <!-- Legacy MaterialComponents attrs some widgets/libraries still read -->
        <item name="colorPrimaryDark">@color/md_surface</item>
        <item name="colorAccent">@color/md_primary</item>
        <item name="android:textColor">@color/md_on_surface</item>
    </style>

    <!--
        Manual color-preset overlays, applied via ThemeManager on top of AppTheme when
        the person picks a preset in Settings — this is what lets the M3 color scheme be
        changed on any Android version, not just 12+ (which is the only OS version with
        real wallpaper-based dynamic color). "Purple" is just AppTheme itself, so it has
        no overlay entry. Only the primary-related roles are overridden; everything else
        (surface, secondary, tertiary, error) is shared with the base theme so the rest
        of the UI doesn't shift, just the accent.
    -->
    <style name="ThemeOverlay.App.Blue" parent="">
        <item name="colorPrimary">@color/preset_blue_primary</item>
        <item name="colorOnPrimary">@color/preset_blue_on_primary</item>
        <item name="colorPrimaryContainer">@color/preset_blue_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/preset_blue_on_primary_container</item>
        <item name="colorAccent">@color/preset_blue_primary</item>
    </style>
    <style name="ThemeOverlay.App.Green" parent="">
        <item name="colorPrimary">@color/preset_green_primary</item>
        <item name="colorOnPrimary">@color/preset_green_on_primary</item>
        <item name="colorPrimaryContainer">@color/preset_green_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/preset_green_on_primary_container</item>
        <item name="colorAccent">@color/preset_green_primary</item>
    </style>
    <style name="ThemeOverlay.App.Orange" parent="">
        <item name="colorPrimary">@color/preset_orange_primary</item>
        <item name="colorOnPrimary">@color/preset_orange_on_primary</item>
        <item name="colorPrimaryContainer">@color/preset_orange_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/preset_orange_on_primary_container</item>
        <item name="colorAccent">@color/preset_orange_primary</item>
    </style>
    <style name="ThemeOverlay.App.Pink" parent="">
        <item name="colorPrimary">@color/preset_pink_primary</item>
        <item name="colorOnPrimary">@color/preset_pink_on_primary</item>
        <item name="colorPrimaryContainer">@color/preset_pink_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/preset_pink_on_primary_container</item>
        <item name="colorAccent">@color/preset_pink_primary</item>
    </style>
</resources>
